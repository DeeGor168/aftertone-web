---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About · Aftertone"
  description="The story behind Aftertone: private, focused, lasting, restrained."
  lang="en"
  path="/en/about"
>
  <section class="section wrap" style="padding-top:72px">
    <p class="eyebrow">About</p>
    <h1>About Aftertone</h1>
    <p class="lead" style="margin-top:12px">
      Aftertone — listen to what lasts. It gives your music collection back to you,
      out of the rental model of streaming platforms.
    </p>
    <div class="grid grid-4" style="margin-top:32px">
      <div class="card"><h3 style="font-size:var(--step-1)">Private</h3><p class="muted" style="margin:8px 0 0">Your music lives on your own disks</p></div>
      <div class="card"><h3 style="font-size:var(--step-1)">Focused</h3><p class="muted" style="margin:8px 0 0">No algorithm, no social feed, no ads</p></div>
      <div class="card"><h3 style="font-size:var(--step-1)">Lasting</h3><p class="muted" style="margin:8px 0 0">Music lives in repeated listening</p></div>
      <div class="card"><h3 style="font-size:var(--step-1)">Restrained</h3><p class="muted" style="margin:8px 0 0">Less is more; the UI yields to the music</p></div>
    </div>
  </section>
</BaseLayout>
