---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Docs · Aftertone"
  description="Aftertone documentation: set up Navidrome, connect Aftertone, configure servers and plugins."
  lang="en"
  path="/en/docs"
>
  <section class="section wrap" style="padding-top:72px">
    <p class="eyebrow">Docs</p>
    <h1>Documentation</h1>
    <p class="lead" style="margin-top:12px">Coming soon.</p>
    <div class="grid grid-3" style="margin-top:32px">
      <div class="card"><h3 style="font-size:var(--step-1)">Getting started</h3><p class="muted" style="margin:8px 0 0">Deploy Navidrome, connect Aftertone, press play</p></div>
      <div class="card"><h3 style="font-size:var(--step-1)">Servers</h3><p class="muted" style="margin:8px 0 0">Navidrome / Subsonic / Jellyfin / Emby / Plex</p></div>
      <div class="card"><h3 style="font-size:var(--step-1)">FAQ</h3><p class="muted" style="margin:8px 0 0">Connection, lyrics, equalizer, desktop lyrics</p></div>
    </div>
  </section>
</BaseLayout>
