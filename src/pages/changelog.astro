---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadRelease } from '../lib/release';

const release = loadRelease();
---

<BaseLayout
  title="更新日志 · 余音 Aftertone"
  description="余音 Aftertone 的版本更新记录。"
  path="/changelog"
>
  <section class="section wrap" style="padding-top:72px">
    <p class="eyebrow">Changelog</p>
    <h1>更新日志</h1>
    {
      release.assets.length > 0 ? (
        <p class="lead" style="margin-top:12px">
          最新版本 v{release.version} ·{' '}
          <a href={release.notesUrl} rel="noopener">查看发布说明</a>
        </p>
      ) : (
        <p class="lead" style="margin-top:12px">尚无已发布版本。</p>
      )
    }
  </section>
</BaseLayout>
